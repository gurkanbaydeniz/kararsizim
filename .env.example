# Bu dosyayı kopyalayıp ".env" olarak yeniden adlandırın ve değerleri doldurun.
# .env ASLA git'e commit edilmez.

# Rastgele uzun bir anahtar üretin (ör. https://djecrety.ir/)
SECRET_KEY=buraya-rastgele-uzun-bir-anahtar-yazin

# Yerel geliştirmede 1, canlıda 0
DEBUG=1

# Supabase -> Project Settings -> Database -> Connection string (URI)
# Serverless (Vercel) uyumlu pooler adresi örneği (port 6543):
# DATABASE_URL=postgresql://postgres.xxxx:SIFRENIZ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL tanımlı değilse proje yerelde sqlite (db.sqlite3) kullanır.
# DATABASE_URL=

# Virgülle ayrılmış host listesi
ALLOWED_HOSTS=localhost,127.0.0.1

# Canlıya (Vercel) çıkarken açın:
# CSRF_TRUSTED_ORIGINS=https://kararsizim.vercel.app
